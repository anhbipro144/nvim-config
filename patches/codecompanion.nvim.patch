+---@param opts { root: string, ref: string }
+---@return table<string, string>|nil
+local function get_submodules(opts)
+  local output = git(opts.root, { "ls-tree", "-rz", opts.ref })
+  if not output then
+    return nil
+  end
+  local submodules = {}
+  for entry in output:gmatch("[^%z]+") do
+    local commit, path = entry:match("^160000 commit (%x+)\t(.+)$")
+    if path then
+      submodules[path] = commit
+    end
+  end
+  return submodules
+end
+
+---@param root string
+---@return boolean
+local function is_initialized(root)
+  local stat = vim.uv.fs_lstat(root)
+  return stat ~= nil and stat.type == "directory" and vim.uv.fs_stat(vim.fs.joinpath(root, ".git")) ~= nil
+end
+
+local write_worktree
+
+---@param opts { root: string, index: string, tree: string }
+---@return boolean
+local function snapshot_submodules(opts)
+  local submodules = get_submodules({ root = opts.root, ref = opts.tree })
+  if not submodules then
+    return false
+  end
+  for path in pairs(submodules) do
+    local root = vim.fs.joinpath(opts.root, path)
+    if is_initialized(root) then
+      local tree = write_worktree(root)
+      -- Stable timestamps keep unchanged submodule snapshots identical between comparisons.
+      local identity = vim.tbl_extend("force", CONSTANTS.IDENTITY, {
+        GIT_AUTHOR_DATE = "2000-01-01T00:00:00Z",
+        GIT_COMMITTER_DATE = "2000-01-01T00:00:00Z",
+      })
+      local commit = tree and git(root, { "commit-tree", tree, "-m", "CodeCompanion submodule snapshot" }, identity)
+      if tree and tree == git(root, { "rev-parse", "HEAD^{tree}" }) then
+        commit = git(root, { "rev-parse", "HEAD" })
+      end
+      if not commit or not git(opts.root, { "update-index", "--cacheinfo", "160000", commit, path }, {
+        GIT_INDEX_FILE = opts.index,
+      }) then
+        return false
+      end
+    end
+  end
+  return true
+end
+
