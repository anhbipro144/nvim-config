+---Keep child snapshots reachable for the lifetime of the parent branch's baseline
+---@param opts { root: string, tree: string, ref: string }
+---@return boolean
+local function retain_submodules(opts)
+  local submodules = get_submodules({ root = opts.root, ref = opts.tree })
+  if not submodules then
+    return false
+  end
+  for path, commit in pairs(submodules) do
+    local root = vim.fs.joinpath(opts.root, path)
+    if is_initialized(root) then
+      -- A parent gitlink does not protect objects from garbage collection in the child repository.
+      if not git(root, { "update-ref", opts.ref, commit })
+        or not retain_submodules({ root = root, tree = commit, ref = opts.ref }) then
+        return false
+      end
+    end
+  end
+  return true
+end
