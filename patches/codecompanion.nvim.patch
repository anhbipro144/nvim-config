+---@param opts { root: string, entries: CodeCompanion.CodeReview.Entry[], lines: string[], diffs: table<string, CC.Diff> }
+---@return table[]
+local function collect_repositories(opts)
+  local groups, by_repository, group = {}, {}, nil
+  for row, entry in ipairs(opts.entries) do
+    if entry.kind == "file" then
+      local root = vim.fs.root(vim.fs.joinpath(opts.root, entry.path), ".git") or opts.root
+      local name = root == opts.root and "." or vim.fs.relpath(opts.root, root)
+      name = name or "."
+      group = by_repository[name]
+      if not group then
+        group = { name = name, rows = {}, files = 0, added = 0, removed = 0 }
+        by_repository[name] = group
+        table.insert(groups, group)
+      end
+      group.files = group.files + 1
+      for _, hunk in ipairs(opts.diffs[entry.path].hunks) do
+        group.added = group.added + hunk.to_count
+        group.removed = group.removed + hunk.from_count
+      end
+    end
+    table.insert(group.rows, { entry = entry, text = opts.lines[row] })
+  end
+  return groups
+end
+
+---@param opts { root: string, entries: CodeCompanion.CodeReview.Entry[], lines: string[], diffs: table<string, CC.Diff> }
+---@return CodeCompanion.CodeReview.Entry[], string[]
+local function group_repositories(opts)
+  local groups = collect_repositories(opts)
+  if #groups == 1 and groups[1].name == "." then
+    return opts.entries, opts.lines
+  end
+  local entries, lines = {}, {}
+  for _, group in ipairs(groups) do
+    local name = group.name == "." and "Workspace" or group.name
+    local label = fmt("%s  %s", name, pluralise(group.files, "file"))
+    local added, removed = fmt("+%d", group.added), fmt("-%d", group.removed)
+    table.insert(entries, {
+      kind = "repository",
+      repository = group.name,
+      spans = {
+        path = { 0, #name },
+        added = { #label + 2, #label + 2 + #added },
+        removed = { #label + 3 + #added, #label + 3 + #added + #removed },
+      },
+    })
+    table.insert(lines, label .. "  " .. added .. " " .. removed)
+    for _, row in ipairs(group.rows) do
+      for _, span in pairs(row.entry.spans or {}) do
+        span[1], span[2] = span[1] + 2, span[2] + 2
+      end
+      table.insert(entries, row.entry)
+      table.insert(lines, "  " .. row.text)
+    end
+  end
+  return entries, lines
+end
+
